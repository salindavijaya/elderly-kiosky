<?xml version="1.0" encoding="utf-8"?>
<!-- Screen-filling layout for Sinhala Voice Listening Indicator -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/listening_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6001E2F"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Outer Glowing Pulse Ring -->
        <FrameLayout
            android:id="@+id/pulse_container"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:background="@drawable/ic_launcher_background"
            android:layout_gravity="center">

            <!-- Glowing Center Mic Background -->
            <ImageView
                android:id="@+id/mic_icon_view"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:contentDescription="Active Sinhala Voice Listening"
                android:src="@drawable/ic_launcher_foreground" />
        </FrameLayout>

        <!-- Primary Sinhala Listening Prompt -->
        <TextView
            android:id="@+id/tv_listening_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="සවන් දෙමින් පවතී..."
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Subtitle / English fallback -->
        <TextView
            android:id="@+id/tv_listening_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="කරුණාකර දැන් කතා කරන්න (Listening in Sinhala)"
            android:textColor="#D1E4FF"
            android:textSize="16sp" />

        <!-- Parsed Intent Result Badge -->
        <TextView
            android:id="@+id/tv_detected_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#33004977"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="#80D5FF"
            android:textSize="18sp"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
